<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>VF_MiningShipCommander_Behavior</SubtypeId>
            </Id>
            <Description>

                [RivalAI Behavior]
                [BehaviorName:CargoShip]

                [AutopilotData:VF_MiningShipCommander_Autopilot]
                [TargetData:VF_MiningShips_Target]
                [WeaponSystem:VF_MiningShips_Weapons]
                [RetreatDespawnDistance:10000]

                [Triggers:VF_MiningFleet_Trigger_UnderAttack]
                [Triggers:VF_MiningFleet_Trigger_UnderAttack_Escalation]
                [Triggers:VF_MiningFleet_Trigger_CallReinforcements]
                [Triggers:VF_MiningFleet_Trigger_FrigateInbound]
                [Triggers:VF_MiningFleet_Trigger_DestroyerInbound]
                [Triggers:VF_MiningFleet_Trigger_CallMediumReinforcements]
                [Triggers:VF_MiningFleet_Trigger_BroadcastRally]

            </Description>
        </EntityComponent>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>VF_SpaceCombatDrone_Behavior</SubtypeId>
            </Id>
            <Description>

                [RivalAI Behavior]
                [BehaviorName:CargoShip]

                [FighterEngageDistanceSpace:800]

                [AutopilotData:VF_SpaceCombatDrone_Autopilot_Cruise]
                [SecondaryAutopilotData:VF_SpaceCombatDrone_Autopilot]
                [TargetData:VF_SpaceCombatDrone_Target]
                [WeaponSystem:VF_SpaceCombatDrone_Weapons]
                [RetreatDespawnDistance:10000]

                [Triggers:VF_SpaceCombatDrone_Trigger_HostileDetected]

            </Description>
        </EntityComponent>

    </EntityComponents>
</Definitions>