                                    <Key>74de02b3-27f9-4960-b1c4-27351f2b06d1</Key>
                                    <Value>[SIMPL - General Config]
Group name=SIMPL
Auto scan=True

; Colors are in the format: Red, Green, Blue, Alpha.
; If you do not want to see a particular subsystem color
; simply set the Alpha value to 0 and it will be
; omitted from the legend.
[SIMPL - Colors]
