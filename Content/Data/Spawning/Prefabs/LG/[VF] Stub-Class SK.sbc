Min block density=10, 10, 10, 255
Missing block=100, 0, 0, 200
Background=0, 0, 0, 255
Weapons=100, 50, 0, 100
Power=0, 100, 0, 100
Gyro=100, 100, 0, 100
Thrust=0, 0, 100, 100

[SIMPL - Text Surface Config]
Number of views for screen 0=1
Number of views for screen 1=0

[SIMPL - Display Config - Screen 0 - View 1]
; View axis values: X, Y, Z, NegativeX, NegativeY, NegativeZ
View axis=X
Rotation (deg)=0
Scale=auto
; Elements should range from -1 to 1 where 0 indicates centered
Position={X:0 Y:0}

[SIMPL - Legend Config - Screen 0]
Legend Scale=1
; Elements should range from -1 to 1 where 0 indicates centered
Position={X:-1 Y:-1}
</Value>
