                            <Value>[SIMPL - General Config]
Group name=SIMPL
Auto scan=True

; Colors are in the format: Red, Green, Blue, Alpha
[SIMPL - Colors]
Min block density=10, 10, 10, 255
Max block density=50, 50, 50, 255
Missing block=100, 0, 0, 200
Background=0, 0, 0, 255

[SIMPL - Legend Categories]
;
; Every line *must* start with the pipe (|) symbol.
; To create a new legend category, put the category name in brackets and
; add the 'Color', 'Block type', and 'Block definitions' keys as described
; below. The order in which you define your custom categories 
; determines its draw priority. The first legend category has the highest
; priority and the last has the lowest priority. You *must* recompile
; if you change the number and/or order of legend items to get SIMPL to
; draw the new items properly.
;
; Color
;   - Specifies the color associated with this category
;   - The format is R, G, B, A
;   - 255, 255, 255, 255 is white and 0, 0, 0, 0 is transparent
;
; Block type
;   - Specifies the block type to associate with this legend category
;   - Valid values: None, Weapons, Thrust, Gyros, Power, Cargo,
;     Tools, Functional, Doors, Pistons, RotorsAndHinges, Wheels,
;     Production, JumpDrives, ShipControllers, or Mechanical
;
; Block definitions
;   - Can contain one or more comma-separated block MyObjectBuilder
;     type definitions
;   - For a list of all block tyoe definitions in the vanilla game, see:
;     https://github.com/malware-dev/MDK-SE/wiki/Type-Definition-Listing#blocks
;   - You can also use this to specify type definitions that are added
;     by mods
;   - Leave this key blank if you do not wish to use it
;
; Example:
;   Legend categories=
;   |[Cargo]
;   |Color=0,100,100,100
;   |Block type=Cargo
;   |Block definitions=
;   |
;   |[Sample text]
;   |Color=100, 0, 50, 100
;   |Block type=None
;   |Block definitions=MyObjectBuilder_Assembler/LargeAssembler,MyObjectBuilder_Assembler/BasicAssembler,MyObjectBuilder_Refinery/Blast Furnace
Legend categories=
|[Weapons]
|Color=100, 50, 0, 100
|Block type=Weapons
|Block definitions=
|
|[Power]
|Color=0, 100, 0, 100
|Block type=Power
|Block definitions=
|
|[Gyros]
|Color=100, 100, 0, 100
|Block type=Gyros
|Block definitions=
|
|[Thrust]
|Color=0, 0, 100, 100
|Block type=Thrust
|Block definitions=

[SIMPL - Text Surface Config]
Number of views for screen 0=1
Number of views for screen 1=0

[SIMPL - Display Config - Screen 0 - View 1]
; View axis values: X, Y, Z, NegativeX, NegativeY, NegativeZ
View axis=X
Rotation (deg)=0
Scale=auto
; Elements should range from -1 to 1 where 0 indicates centered
Position={X:0 Y:0}

[SIMPL - Legend Config - Screen 0]
Legend Scale=1
; Elements should range from -1 to 1 where 0 indicates centered
Position={X:-1 Y:-1}
</Value>
                          </item>
                        </dictionary>
                      </Storage>
                    </Component>
                  </ComponentData>
                </Components>
              </ComponentContainer>
              <CustomName>SIMPL script block</CustomName>
              <ShowOnHUD>false</ShowOnHUD>
              <ShowInTerminal>true</ShowInTerminal>
